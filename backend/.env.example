# ── Mode switch ──────────────────────────────────────────────────────────
# true  = SQLite + local file storage + rule-based mock LLM + in-memory vector
#         search. Zero external accounts. This is the default and what ships
#         "working" out of the box.
# false = real Supabase + Gemini + Qdrant + BAAI/bge-m3. Fill in every value
#         below and `pip install -r requirements-real.txt` first.
DEMO_MODE=true

# ── Supabase (real mode only) ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Gemini (real mode only) ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Qdrant (real mode only) ─────────────────────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=synthetix_evidence

# ── Embeddings (real mode only) ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ── App ──────────────────────────────────────────────────────────────────
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_MB=10
SQLITE_PATH=./synthetix_demo.db
LOCAL_STORAGE_DIR=./storage
