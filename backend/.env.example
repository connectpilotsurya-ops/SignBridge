# Mode switch
DEMO_MODE=true

# Supabase (real mode only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini (real mode only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Qdrant (real mode only)
QDRANT_URL=https://your-qdrant-cluster.example.com
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=synthetix_evidence

# Embeddings (real mode only)
EMBEDDING_MODEL=BAAI/bge-m3

# App
API_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
SQLITE_PATH=./synthetix_demo.db
LOCAL_STORAGE_DIR=./storage
